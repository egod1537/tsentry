# Pinned getsentry/self-hosted release. Never use master, nightly, or latest.
SENTRY_SELF_HOSTED_VERSION=26.9.0

# Listen only on the Mac mini itself. Put an authenticated reverse proxy or
# SSH tunnel in front of Sentry for access from another machine.
SENTRY_BIND=127.0.0.1:9000

# Canonical public URL used for UI links, email links, and generated DSNs.
# The edge route must remain disabled until Cloudflare Access is configured.
SENTRY_SYSTEM_URL_PREFIX=https://sentry.mangagaki.net

# Number of days that Sentry retains events.
SENTRY_EVENT_RETENTION_DAYS=14

# Error Monitoring only. Enabling feature-complete is a separate capacity and
# change-management decision.
COMPOSE_PROFILES=errors-only

# Optional: fixed helper image used only to archive Docker volumes.
TSENTRY_BACKUP_IMAGE=alpine:3.22.1
